# 统一换行符，避免 Windows / macOS / Linux 之间来回改动
* text=auto

# 脚本在 Linux/macOS 上必须能用 LF 执行
*.sh            text eol=lf
gradlew         text eol=lf
gradlew.bat     text eol=crlf

# Windows 批处理
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 二进制文件不要做换行转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.jar           binary
*.jks           binary
*.keystore      binary
*.apk           binary
*.aab           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.zip           binary
*.db            binary

# 语言统计时不算第三方依赖的生成物
admin/dist/**   linguist-generated=true
pnpm-lock.yaml  linguist-generated=true
