# 复制成 .env 再填，.env 不要提交到仓库。
# 开发（本机直接跑）默认用 SQLite，不用改：
# DATABASE_URL=sqlite:///./data/miaoledger.db
#
# 生产建议用 PostgreSQL（docker compose 里对应服务名 db）：
# DATABASE_URL=postgresql+psycopg://miaoledger:<数据库口令>@db:5432/miaoledger

# 数据库连接串：留空则用 ./data/miaoledger.db（SQLite）
DATABASE_URL=

# 注册邀请码：留空 = 不校验（开放注册）；非空 = 注册须填写正确值
INVITE_CODE=

# 管理员账号名：启动时把已注册的这个账号自动提为 admin（留空则不提）
# 也可以事后用 CLI：python -m app.cli promote <账号>
ADMIN_USERNAME=

# 大模型：留空则不调用，只用服务端本地规则引擎
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 语音识别（火山引擎）：留空则 /asr 返回 503
VOLC_API_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# APK 下载目录：容器里挂到 /apk；留空或不存在则不挂载
APK_DIR=/apk

# 跨域来源：逗号分隔；管理台默认与 API 同源反代，通常留空
CORS_ORIGINS=

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------- docker compose 用
# docker-compose.yml 里 postgres 服务读取下面这些（只在 compose 场景需要）
POSTGRES_DB=miaoledger
POSTGRES_USER=miaoledger
POSTGRES_PASSWORD=
