# 小喵记账 —— 部署环境变量示例
#
#   cp .env.example .env
#   编辑 .env，至少为 POSTGRES_PASSWORD 设置强口令
#   docker compose up -d
#
# 这个文件里的值都是占位示例，不要直接用于生产。

# ===== 数据库 =====
POSTGRES_USER=miaoledger
POSTGRES_PASSWORD=
POSTGRES_DB=miaoledger

# ===== 账号 =====
# 注册邀请码。留空 = 允许任何人注册（本地试运行的常见配置）；
# 填上之后，注册时必须填对，否则 403。
INVITE_CODE=

# 把哪个用户名提升为管理员（管理台「用户管理」需要 admin 角色）。
# 留空则不提升任何人，之后可以用 `docker compose exec api python -m app.cli promote <用户名>` 手动提升。
ADMIN_USERNAME=

# ===== AI 记账（可选）=====
# 留空则只用内置规则引擎解析，不联网、不产生费用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 语音记账（可选）=====
# 留空则 App 里的语音按钮会提示「服务端未启用语音识别」。
VOLC_API_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# ===== 运行 =====
TZ=Asia/Shanghai
API_PORT=8000
ADMIN_PORT=8080
