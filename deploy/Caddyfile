{
	# 不给 admin 接口开在本机之外
	admin 127.0.0.1:2019
	# 80 端口归 NPM（主域名站点），这里不要抢，也不做 http->https 跳转
	auto_https disable_redirects
	# HTTP/3 在 3Mbps 的小水管上没意义，关掉省点麻烦
	servers {
		protocols h1 h2
	}
}

# 小喵记账 API：直连 ECS，TLS 由 Caddy 自动申请与续期（TLS-ALPN-01，不占 80 端口）
jz.doctormdkzrp.cn {
	encode zstd gzip

	# 请求体上限与 app 内一致（12MB），边缘先挡一层
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8000

	# 静态 APK 允许客户端缓存一小时，别每次都拉 19MB
	@apk path /apk/*
	header @apk Cache-Control "public, max-age=3600"

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}
